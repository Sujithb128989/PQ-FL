# Multi-stage build: OQS-OpenSSL stunnel + Python FL client
#
# Produces a container where stunnel (compiled against OQS-OpenSSL) handles
# Dilithium5 mTLS to the PQ-FL server, while the Python gRPC client connects
# to stunnel over localhost plaintext.

# ---------------------------------------------------------------------------
# STAGE 1: Build stunnel 5.78 against OQS-OpenSSL
# ---------------------------------------------------------------------------
# Reuse the PQ-FL server image which already has OQS-OpenSSL at /opt/openssl
FROM pqfl-server:latest AS oqs-base

FROM ubuntu:focal AS stunnel-builder

# Copy OQS-OpenSSL from server image
COPY --from=oqs-base /opt/openssl /opt/openssl

# Install build dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
      build-essential wget ca-certificates \
      && apt-get clean

ENV PATH="/opt/openssl/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/openssl/lib"

# Build stunnel 5.78 from source, linked against OQS-OpenSSL
ARG STUNNEL_VERSION=5.78
RUN wget -q "https://www.stunnel.org/downloads/stunnel-${STUNNEL_VERSION}.tar.gz" \
      -O /tmp/stunnel.tar.gz \
      --no-check-certificate \
    && cd /tmp \
    && tar xzf stunnel.tar.gz \
    && cd "stunnel-${STUNNEL_VERSION}" \
    && ./configure \
         --prefix=/opt/stunnel \
         --with-ssl=/opt/openssl \
         --disable-systemd \
         --disable-libwrap \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/stunnel*

# Verify stunnel links to OQS-OpenSSL
RUN /opt/stunnel/bin/stunnel -version 2>&1 | head -5

# ---------------------------------------------------------------------------
# STAGE 2: Python FL client runtime
# ---------------------------------------------------------------------------
FROM ubuntu:focal

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
      ca-certificates \
      wget \
      python3.9 \
      python3.9-dev \
      python3.9-venv \
      python3.9-distutils \
      python3-pip \
      libffi-dev \
      socat \
      && apt-get clean

# Copy OQS-OpenSSL libraries (for stunnel runtime + cert inspection)
COPY --from=oqs-base /opt/openssl /opt/openssl

# Copy stunnel binary
COPY --from=stunnel-builder /opt/stunnel /opt/stunnel
ENV PATH="/opt/stunnel/bin:/opt/openssl/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/openssl/lib"

# Update dynamic linker
RUN ldconfig

# Install Python dependencies using python3.9
WORKDIR /app
COPY clients/python_fl_client/requirements.txt /app/requirements.txt
RUN python3.9 -m pip install --no-cache-dir --upgrade pip setuptools \
    && python3.9 -m pip install --no-cache-dir -r requirements.txt

# Create an alias so python/python3 points to python3.9
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.9 1

# Copy client code and proto definitions
COPY clients/python_fl_client/ /app/client/
COPY proto/ /app/proto/

# Copy stunnel configuration
COPY clients/python_fl_client/stunnel-client.conf /app/stunnel-client.conf

# Copy entrypoint
COPY clients/python_fl_client/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# The proto dir for the client needs to be adjusted since we're
# running from /app/client/ but proto is at /app/proto/
ENV PQFL_PROTO_DIR=/app/proto

ENTRYPOINT ["/app/entrypoint.sh"]
