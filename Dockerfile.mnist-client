# Multi-stage build: OQS-OpenSSL stunnel + Python MNIST client
#
# Produces a container where stunnel (compiled against OQS-OpenSSL) handles
# Dilithium5 mTLS to the PQ-FL server, while the Python gRPC client connects
# to stunnel over localhost plaintext.

# ---------------------------------------------------------------------------
# STAGE 1: Build stunnel against OQS-OpenSSL
# ---------------------------------------------------------------------------
# Reuse the PQ-FL server image which already has OQS-OpenSSL at /opt/openssl
FROM pqfl-server:latest AS oqs-base

FROM ubuntu:focal AS stunnel-builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
      build-essential wget ca-certificates \
      && apt-get clean

# Copy OQS-OpenSSL from the pqfl-server image
COPY --from=oqs-base /opt/openssl /opt/openssl
ENV PATH="/opt/openssl/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/openssl/lib"

# Build stunnel 5.72 from source, linked against OQS-OpenSSL
ARG STUNNEL_VERSION=5.72
RUN wget -q "https://www.stunnel.org/archive/5.x/stunnel-${STUNNEL_VERSION}.tar.gz" \
      -O /tmp/stunnel.tar.gz \
    && cd /tmp \
    && tar xzf stunnel.tar.gz \
    && cd "stunnel-${STUNNEL_VERSION}" \
    && ./configure \
         --prefix=/opt/stunnel \
         --with-ssl=/opt/openssl \
         --disable-systemd \
         --disable-libwrap \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/stunnel*

# Verify stunnel links to OQS-OpenSSL
RUN /opt/stunnel/bin/stunnel -version 2>&1 | head -5

# ---------------------------------------------------------------------------
# STAGE 2: Python MNIST client runtime
# ---------------------------------------------------------------------------
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
      ca-certificates libffi-dev \
      && apt-get clean

# Copy OQS-OpenSSL libraries (for stunnel runtime + cert inspection)
COPY --from=oqs-base /opt/openssl /opt/openssl

# Copy stunnel binary
COPY --from=stunnel-builder /opt/stunnel /opt/stunnel
ENV PATH="/opt/stunnel/bin:/opt/openssl/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/openssl/lib"

# Update dynamic linker
RUN ldconfig

# Install Python dependencies
WORKDIR /app
COPY clients/mnist/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy client code and proto definitions
COPY clients/mnist/ /app/client/
COPY proto/ /app/proto/

# Copy stunnel configuration
COPY clients/mnist/stunnel-client.conf /app/stunnel-client.conf

# Copy entrypoint
COPY clients/mnist/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# The proto dir for the client needs to be adjusted since we're
# running from /app/client/ but proto is at /app/proto/
ENV PQFL_PROTO_DIR=/app/proto

ENTRYPOINT ["/app/entrypoint.sh"]
